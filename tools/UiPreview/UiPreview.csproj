<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitTargetFramework)' == ''">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' != ''">$(RevitTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2023</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit 2023</RevitApiDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\outputs\IFCInfo.csproj" AdditionalProperties="AssemblyName=IFCInfo_Revit$(RevitVersion)" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
